set -eu

# Detached HEADs are used by rebases and cherry-picks.
branch=$(git symbolic-ref --quiet --short HEAD || true)
if [ -n "$branch" ]; then
  case "$branch" in
    main|develop) ;;
    *)
      if ! printf '%s\n' "$branch" | grep -Eq '^(feat|fix|chore|docs|test|refactor|hotfix|release|perf|ci|build)/[a-zA-Z0-9][a-zA-Z0-9./-]*$'; then
        printf 'Invalid branch name: %s\nUse a branch such as feat/add-payments or fix/cli-path. See CONTRIBUTING.md.\n' "$branch" >&2
        exit 1
      fi
      ;;
  esac
fi

npm run lint:staged
